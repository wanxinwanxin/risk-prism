# Packing rules for `railway up` — replaces .gitignore for deploys, because
# site/history/ is gitignored (25MB of generated snapshots) but MUST ship.
# src/ + pyproject MUST ship too: the image runs the FastAPI server.
.git/
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
artifacts/
docs/
scripts/
tests/
!site/history/
